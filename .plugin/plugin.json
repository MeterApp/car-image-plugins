    "name": "Meter",
    "email": "hello@meterapp.co",
    "url": "https://meterapp.co"
  },
  "homepage": "https://carimage.dev/docs?ref=plugin",
  "repository": "https://github.com/MeterApp/car-image-plugins",
  "license": "MIT",
  "keywords": ["car", "vehicle", "image", "render", "automotive", "mcp", "png", "transparent"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Car Image API",
        "category": "Productivity",
        "privacyPolicyURL": "https://carimage.dev/privacy?ref=plugin",
        "termsOfServiceURL": "https://carimage.dev/terms?ref=plugin"
      }
    }
