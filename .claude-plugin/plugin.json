{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "car-image",
  "displayName": "Car Image API",
  "icon": ".claude-plugin/icon.png",
  "version": "1.34.0",
  "description": "Studio-quality, transparent-background vehicle images for any project. Render any make, model and year in 9 camera views and any paint color, mint signed URLs a browser can load without a key, fetch catalog make logos, decode VINs for free, or build a 3D model of any vehicle.",
  "author": {
    "name": "Meter",
    "email": "jonathan@carimage.dev",
    "url": "https://meterapp.co"
  },
  "homepage": "https://carimage.dev/docs?ref=plugin",
  "repository": "https://github.com/MeterApp/car-image-plugins",
  "license": "MIT",
  "privacyPolicyUrl": "https://carimage.dev/privacy?ref=plugin",
  "termsOfServiceUrl": "https://carimage.dev/terms?ref=plugin",
  "supportUrl": "https://carimage.dev/docs?ref=plugin",
  "keywords": [
    "car",
    "vehicle",
    "image",
    "render",
    "automotive",
    "mcp",
    "png",
    "transparent"
  ],
  "mcpServers": {
    "car-image": {
      "type": "http",
      "url": "https://carimage.dev/api/mcp?toolset=all",
      "headers": {
        "X-CarImage-Integration": "plugin",
        "X-CarImage-Plugin-Version": "1.34.0",
        "X-CarImage-Plugin-Channel": "mcp-json"
      }
    },
    "car-image-catalog": {
      "type": "http",
      "url": "https://carimage.dev/api/mcp/catalog",
      "headers": {
        "X-CarImage-Integration": "plugin",
        "X-CarImage-Plugin-Version": "1.34.0",
        "X-CarImage-Plugin-Channel": "mcp-json"
      }
    }
  }
}
